{
  "manifest": "data/neu_cls/manifest.csv",
  "splits": "data/neu_cls/splits.json",
  "output": "runs/neu_cls/castgate",
  "fold": 0,
  "seed": 42,
  "image_size": 224,
  "batch_size": 8,
  "num_workers": 0,
  "epochs": 40,
  "warmup_epochs": 5,
  "patience": 10,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "device": "auto",
  "cpu_threads": 4,
  "pretrained": true,
  "cnn": "resnet18.tv_in1k",
  "transformer": "vit_tiny_patch16_224.augreg_in21k_ft_in1k",
  "gate_hidden": 128,
  "cnn_weights": ".cache/weights/resnet18.tv_in1k.pth",
  "transformer_weights": ".cache/weights/vit_tiny_patch16_224.augreg_in21k_ft_in1k.npz",
  "mode": "reliability_gate",
  "num_stain_views": 2,
  "stain_strength": 0.15,
  "perturbation": "illumination",
  "geometry_mode": "industrial",
  "class_names": ["crazing", "inclusion", "patches", "pitted_surface", "rolled_in_scale", "scratches"],
  "reliability": "joint",
  "stability_beta": 1.0,
  "temperature": 0.5,
  "lambda_branch": 1.0,
  "lambda_gate": 0.5,
  "bootstrap_samples": 1000,
  "synthetic": false
}
